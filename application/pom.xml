<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot 3.5.16 — the latest patch on the 3.5.x line (2026-06-25).

      History of this pin:
        3.3.5  -> failed the OWASP gate on jackson-databind 2.17.2 and
                  log4j-api 2.23.1 (real CVEs, CVSS >= 9).
        3.5.6  -> cleared those; verified against the upstream release list that
                  3.5.16 was in fact the newest 3.5.x.
        3.5.16 -> current. jackson-databind 2.21.4 and log4j-api 2.24.3 are now
                  below the critical threshold.

      Deliberately staying on 3.5.x rather than moving to 4.x: a major upgrade
      brings breaking changes (dependency baselines, config property migrations)
      that are a separate, reviewed piece of work — not something to fold into a
      security patch.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>xyz.royalbengal.shopfast</groupId>
    <artifactId>shopfast</artifactId>
    <version>1.0.0</version>
    <name>ShopFast</name>
    <description>ShopFast GitOps delivery platform demo service</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <dependency-check.version>12.1.0</dependency-check.version>

        <!--
          NVD database location — pinned so CI can CACHE it.

          dependency-check defaults this to ~/.m2/repository/org/owasp/
          dependency-check-data/<n>/, which the maven cache key (keyed on
          pom.xml) does not reliably preserve.

          Downloading the full NVD feed is ~387,000 records, and there is no
          partial mode: the whole corpus must land before a single jar can be
          inspected. Measured throughput on consecutive days ranged from ~97,000
          records/min (4m46s total) to ~2,600 records/min (~2.5h projected), and
          one run was aborted by NVD itself mid-fetch. Because that rate is not
          ours to control, the scan was moved OUT of the deploy pipeline into
          the `security-deps` workflow, which has a 3-hour budget and is the
          only writer of the shared nvd-db-* Actions cache.

          With this path pinned, that workflow restores the directory and
          dependency-check fetches only the delta since the cached snapshot.
          See docs/DEPENDENCY-SCANNING.md.
        -->
        <nvd.data.directory>${user.home}/.dependency-check-data</nvd.data.directory>

        <!--
          ====================================================================
          ACCEPTED RISK — dependency-check runs in REPORTING mode.
          Decision: project owner, 2026-09-06.
          ====================================================================

          CVSS 11 is above the maximum possible score (10.0), so no finding can
          fail the build. The scan STILL RUNS (in the `security-deps` workflow —
          see the nvd.data.directory note above) and still publishes its full
          HTML report — findings remain visible, they simply no longer block
          delivery.

          WHY: Spring Boot 3.5.16 — the newest release of this line — ships
          transitive dependencies with unpatched criticals in the HTTP stack:

            spring-core 6.2.19 / spring-web 6.2.19
              CVE-2026-59313 (9.8), CVE-2026-47892 (9.8), CVE-2026-47891 (9.8),
              CVE-2026-47890 (9.8), CVE-2026-59283 (9.1)
            tomcat-embed-core 10.1.55
              CVE-2026-65905 (9.8), CVE-2026-65637 (9.8), CVE-2026-53434 (9.1),
              CVE-2026-55276 (9.1), CVE-2026-59083 (9.1), CVE-2026-59084 (9.1),
              CVE-2026-65182 (9.1), CVE-2026-68525 (9.1)

          These are NOT false positives — each artifact matches its own correct
          CPE. There is no upstream version that resolves them today, so the
          only alternatives were "never deploy" or "suppress real criticals".
          Reporting mode was chosen over suppression because it keeps the
          findings visible and auditable rather than hiding them.

          COMPENSATING CONTROLS still enforced:
            - Trivy scans the built container image (HIGH/CRITICAL) in build_push
            - ECR scan-on-push
            - Pods run non-root, read-only rootfs, all capabilities dropped
            - The app exposes only /api/hello and three actuator endpoints

          REVISIT WHEN: upstream ships patched spring-framework / tomcat
          versions — then restore this to 9 and upgrade. Re-evaluate BEFORE this
          service handles real user data.
        -->
        <security.failBuildOnCVSS>11</security.failBuildOnCVSS>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- /actuator/health and /actuator/prometheus -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Exposes Micrometer metrics in Prometheus text format -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>shopfast</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Pinned here so the security-deps workflow and any local run use the
              same analyzer version and settings. Invoked by
              scripts/dependency-scan.sh.
            -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <!-- See the security.failBuildOnCVSS property above for the
                         accepted-risk rationale and the revisit condition. -->
                    <failBuildOnCVSS>${security.failBuildOnCVSS}</failBuildOnCVSS>
                    <!-- Cacheable NVD location — see the nvd.data.directory
                         property above for why this is pinned. -->
                    <dataDirectory>${nvd.data.directory}</dataDirectory>
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                    <!--
                      Sonatype OSS Index needs its own account. Without credentials
                      it logs "Invalid credentials" for every jar and adds nothing;
                      NVD remains the authoritative source here.
                    -->
                    <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                    <!-- Both HTML (human review) and JSON (machine parsing). -->
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <suppressionFiles>
                        <suppressionFile>${project.basedir}/owasp-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
